   <item><widget class="QLabel" name="label_title"><property name="text"><string>Guided Setup (new)</string></property><property name="wordWrap"><bool>true</bool></property><property name="font"><font><pointsize>14</pointsize><weight>75</weight><bold>true</bold></font></property><property name="styleSheet"><string notr="true">color:#F0F0F0;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item>
   <item><widget class="QLabel" name="label_hint"><property name="text"><string>Teach the trolley once: fid0, the four corners, slots, units and inspection points. Everything is stored in this recipe's guidedSetup2.json; the old Guided Setup is not touched.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item>
   <item><widget class="QFrame" name="frame_top"><property name="frameShape"><enum>QFrame::StyledPanel</enum></property><property name="styleSheet"><string notr="true">QFrame{background-color:#272c36; border-radius:12px;}QLabel{color:#F0F0F0;}QCheckBox{color:#F0F0F0;}QCheckBox::indicator:checked{background-color:#5F8FCB; border:3px solid #9DB8E0;}QSpinBox, QDoubleSpinBox, QComboBox{background-color:rgb(27,29,35); color:#F0F0F0; border:1px solid rgb(27,29,35); border-radius:5px; padding-left:6px; min-height:22px;}QListWidget{background-color:rgb(27,29,35); color:#F0F0F0; border-radius:5px;}QToolButton{background-color:#4A5F8C; color:#F0F0F0; border-radius:6px; padding:4px 10px;}QToolButton:hover{background-color:#5F8FCB;}QToolButton:pressed{border:1px solid #FFE723;}QToolButton:checked{background-color:#5F8FCB; border:1px solid #FFE723;}QToolButton:disabled{color:#6e6e6e; background-color:#444444;}</string></property><layout class="QVBoxLayout" name="vl_top"><item><layout class="QHBoxLayout" name="hl_top"><property name="spacing"><number>6</number></property><item><widget class="QLabel" name="label_recipe"><property name="text"><string>Recipe: -</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item><widget class="QToolButton" name="toolButton_showLayout"><property name="text"><string>Show layout</string></property><property name="toolTip"><string>Switch the big image area between the camera and the layout of this recipe.</string></property><property name="checkable"><bool>true</bool></property></widget></item></layout></item><item><layout class="QHBoxLayout" name="hl_bottom"><property name="spacing"><number>6</number></property><item><widget class="QLabel" name="label_saveState"><property name="text"><string>Saved</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item><widget class="QToolButton" name="toolButton_discard"><property name="text"><string>Discard</string></property><property name="toolTip"><string>Throw away the changes since the last Save.</string></property></widget></item><item><widget class="QToolButton" name="toolButton_save"><property name="text"><string>Save</string></property><property name="toolTip"><string>Write this recipe's guidedSetup2.json.</string></property></widget></item></layout></item></layout></widget></item>
   <item><widget class="QLabel" name="label_banner"><property name="text"><string></string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color:#FFB347;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item>
   <item><widget class="QScrollArea" name="scrollArea_gs2"><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAsNeeded</enum></property><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollContents_gs2"><property name="geometry"><rect><x>0</x><y>0</y><width>600</width><height>1300</height></rect></property><layout class="QVBoxLayout" name="vl_sections"><property name="spacing"><number>10</number></property><property name="leftMargin"><number>0</number></property><property name="rightMargin"><number>4</number></property><item><widget class="QFrame" name="frame_tools"><property name="frameShape"><enum>QFrame::StyledPanel</enum></property><property name="styleSheet"><string notr="true">QFrame{background-color:#272c36; border-radius:12px;}QLabel{color:#F0F0F0;}QCheckBox{color:#F0F0F0;}QCheckBox::indicator:checked{background-color:#5F8FCB; border:3px solid #9DB8E0;}QSpinBox, QDoubleSpinBox, QComboBox{background-color:rgb(27,29,35); color:#F0F0F0; border:1px solid rgb(27,29,35); border-radius:5px; padding-left:6px; min-height:22px;}QListWidget{background-color:rgb(27,29,35); color:#F0F0F0; border-radius:5px;}QToolButton{background-color:#4A5F8C; color:#F0F0F0; border-radius:6px; padding:4px 10px;}QToolButton:hover{background-color:#5F8FCB;}QToolButton:pressed{border:1px solid #FFE723;}QToolButton:checked{background-color:#5F8FCB; border:1px solid #FFE723;}QToolButton:disabled{color:#6e6e6e; background-color:#444444;}</string></property><layout class="QGridLayout" name="gl_tools"><property name="horizontalSpacing"><number>10</number></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel" name="label_tTitle"><property name="text"><string>Camera and circle finder</string></property><property name="font"><font><pointsize>11</pointsize><weight>75</weight><bold>true</bold></font></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="0" column="1" colspan="2"><widget class="QLabel" name="label_tState"><property name="text"><string>Circle settings are saved with the recipe; the tools and the pixel-to-mm choice are machine-wide</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="1" column="0"><widget class="QLabel" name="label_tRow1"><property name="text"><string>Circle</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="1" column="1"><widget class="QComboBox" name="comboBox_tCircle"><property name="toolTip"><string>Which kind of circle the settings below are for, and which one the tools look for. Each kind has its own settings, saved with the recipe.</string></property><item><property name="text"><string>fid0 (B)</string></property></item><item><property name="text"><string>Corners (D)</string></property></item><item><property name="text"><string>Slot circles (E)</string></property></item></widget></item><item row="1" column="2"><widget class="QLabel" name="label_tRange"><property name="text"><string>-</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="2" column="0"><widget class="QLabel" name="label_tRowDia"><property name="text"><string>Diameter</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="2" column="1"><layout class="QHBoxLayout" name="hl_tDia"><property name="spacing"><number>6</number></property><item><widget class="QDoubleSpinBox" name="dspin_tDiaMin"><property name="toolTip"><string>The circle diameter range the finder accepts, in mm. Keep it tight round the real circle: a second edge of the same circle (a chamfer, a ring) inside the range makes the centre jump between snaps.</string></property><property name="decimals"><number>2</number></property><property name="minimum"><double>0</double></property><property name="maximum"><double>100</double></property><property name="singleStep"><double>0.05</double></property><property name="keyboardTracking"><bool>false</bool></property><property name="minimumSize"><size><width>95</width><height>0</height></size></property><property name="suffix"><string> mm</string></property></widget></item><item><widget class="QDoubleSpinBox" name="dspin_tDiaMax"><property name="toolTip"><string>The circle diameter range the finder accepts, in mm. Keep it tight round the real circle: a second edge of the same circle (a chamfer, a ring) inside the range makes the centre jump between snaps.</string></property><property name="decimals"><number>2</number></property><property name="minimum"><double>0</double></property><property name="maximum"><double>100</double></property><property name="singleStep"><double>0.05</double></property><property name="keyboardTracking"><bool>false</bool></property><property name="minimumSize"><size><width>95</width><height>0</height></size></property><property name="suffix"><string> mm</string></property></widget></item></layout></item><item row="2" column="2"><widget class="QLabel" name="label_tDiaPx"><property name="text"><string></string></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="3" column="0"><widget class="QLabel" name="label_tRowPolarity"><property name="text"><string>Polarity</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="3" column="1"><widget class="QComboBox" name="comboBox_tPolarity"><property name="toolTip"><string>Bright: the circle is lighter than what is round it. Dark: darker. Either: both, and the finder may then also lock onto an edge of the other kind.</string></property><item><property name="text"><string>Bright circle</string></property></item><item><property name="text"><string>Dark circle</string></property></item><item><property name="text"><string>Either</string></property></item></widget></item><item row="3" column="2"><widget class="QLabel" name="label_tPolarityNote"><property name="text"><string>which edge: lighter or darker inside</string></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="4" column="0"><widget class="QLabel" name="label_tRowScore"><property name="text"><string>Min score</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="4" column="1"><widget class="QSpinBox" name="spin_tScore"><property name="toolTip"><string>The lowest match (out of 100) the finder keeps. Higher drops weak, partial circles.</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>100</number></property><property name="keyboardTracking"><bool>false</bool></property><property name="minimumSize"><size><width>80</width><height>0</height></size></property></widget></item><item row="4" column="2"><widget class="QLabel" name="label_tScoreNote"><property name="text"><string>out of 100; the IPC fid0 scores 80 - 95</string></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="5" column="0"><widget class="QLabel" name="label_tRowSmooth"><property name="text"><string>Edge smoothness</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="5" column="1"><widget class="QSpinBox" name="spin_tSmooth"><property name="toolTip"><string>How much the image is smoothed before the edges are taken (Matrox default 50). Higher: fewer noise edges and a steadier centre, but soft edges move. Lower: sharper detail, more noise.</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="keyboardTracking"><bool>false</bool></property><property name="minimumSize"><size><width>80</width><height>0</height></size></property></widget></item><item row="5" column="2"><widget class="QLabel" name="label_tSmoothNote"><property name="text"><string>Matrox default 50; higher = less noise</string></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="6" column="0"><widget class="QLabel" name="label_tRowDetail"><property name="text"><string>Edge detail</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="6" column="1"><widget class="QComboBox" name="comboBox_tDetail"><property name="toolTip"><string>How many edges the finder extracts (Matrox default Medium). Higher finds faint or partly hidden circles, and also more noise.</string></property><item><property name="text"><string>Medium</string></property></item><item><property name="text"><string>High</string></property></item><item><property name="text"><string>Very high</string></property></item></widget></item><item row="6" column="2"><widget class="QLabel" name="label_tDetailNote"><property name="text"><string>Matrox default Medium</string></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="7" column="0"><widget class="QLabel" name="label_tRowAccuracy"><property name="text"><string>Accuracy</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="7" column="1"><widget class="QCheckBox" name="checkBox_tHighAcc"><property name="text"><string>High (finer sub-pixel)</string></property><property name="toolTip"><string>Fits the circle position more finely, a little slower (Matrox default Medium).</string></property></widget></item><item row="7" column="2"><widget class="QLabel" name="label_tAccNote"><property name="text"><string>slower</string></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="8" column="0"><widget class="QLabel" name="label_tRow2"><property name="text"><string>Pixel to mm</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="8" column="1"><widget class="QComboBox" name="comboBox_tConversion"><property name="toolTip"><string>How an image pixel becomes world mm for Guided Setup (new) on this machine, every recipe. Nothing else in the app uses this choice.</string></property><item><property name="text"><string>Set (Camera Scaling)</string></property></item><item><property name="text"><string>Measured</string></property></item></widget></item><item row="8" column="2"><widget class="QLabel" name="label_tConversion"><property name="text"><string>-</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="9" column="0" colspan="3"><layout class="QHBoxLayout" name="hl_tButtons"><property name="spacing"><number>6</number></property><item><widget class="QToolButton" name="toolButton_tFindImage"><property name="text"><string>Find in image</string></property><property name="toolTip"><string>Find the circle in the image on screen (live or Load FOV). No snap, no movement.</string></property></widget></item><item><widget class="QToolButton" name="toolButton_tSnapFind"><property name="text"><string>Snap + find</string></property><property name="toolTip"><string>Snap here and convert the circle to world X/Y, as the run will. The camera moves onto the circle and snaps again only if it lies outside the middle half of the image.</string></property></widget></item><item><widget class="QToolButton" name="toolButton_tCentre"><property name="text"><string>Centre on circle</string></property><property name="toolTip"><string>Move the camera onto the circle nearest the image centre and snap again until it is centred, as the teach buttons will.</string></property></widget></item><item><spacer name="hs_tButtons"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item></layout></item><item row="10" column="0" colspan="3"><layout class="QHBoxLayout" name="hl_tButtons2"><property name="spacing"><number>6</number></property><item><widget class="QToolButton" name="toolButton_tDirection"><property name="text"><string>Check camera direction</string></property><property name="toolTip"><string>Centre on a circle, then snap it from a 3 x 3 grid +/- 5 mm round it (each snap waits for the head to stop), fit how the image moves and compare it with the Set and the saved Measured conversion. About 20 s. Saves nothing by itself.</string></property></widget></item><item><widget class="QToolButton" name="toolButton_tSaveMeasured"><property name="text"><string>Save measured</string></property><property name="toolTip"><string>Keep the last Check camera direction as the Measured conversion for this machine.</string></property></widget></item><item><widget class="QToolButton" name="toolButton_tStability"><property name="text"><string>Stability test</string></property><property name="toolTip"><string>Snap the circle 10 times without moving and report how far its centre and diameter wander: tune the settings above until the spread is small. Moves nothing.</string></property></widget></item><item><spacer name="hs_tButtons2"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item></layout></item><item row="11" column="0" colspan="3"><widget class="QLabel" name="label_tResult"><property name="text"><string>No result yet.</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="12" column="0" colspan="3"><widget class="QLabel" name="label_tNote"><property name="text"><string>Works at the current Z and light: bring the circle into focus first. Set = this machine's Camera Scaling, image right = +X and image down = +Y, as production's fiducials assume. Measured = the matrix the last saved Check camera direction measured; it holds until Camera Alignment changes the image rotation.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item></layout></widget></item><item><widget class="QFrame" name="frame_a"><property name="frameShape"><enum>QFrame::StyledPanel</enum></property><property name="styleSheet"><string notr="true">QFrame{background-color:#272c36; border-radius:12px;}QLabel{color:#F0F0F0;}QCheckBox{color:#F0F0F0;}QCheckBox::indicator:checked{background-color:#5F8FCB; border:3px solid #9DB8E0;}QSpinBox, QDoubleSpinBox, QComboBox{background-color:rgb(27,29,35); color:#F0F0F0; border:1px solid rgb(27,29,35); border-radius:5px; padding-left:6px; min-height:22px;}QListWidget{background-color:rgb(27,29,35); color:#F0F0F0; border-radius:5px;}QToolButton{background-color:#4A5F8C; color:#F0F0F0; border-radius:6px; padding:4px 10px;}QToolButton:hover{background-color:#5F8FCB;}QToolButton:pressed{border:1px solid #FFE723;}QToolButton:checked{background-color:#5F8FCB; border:1px solid #FFE723;}QToolButton:disabled{color:#6e6e6e; background-color:#444444;}</string></property><layout class="QGridLayout" name="gl_a"><property name="horizontalSpacing"><number>10</number></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel" name="label_aTitle"><property name="text"><string>A   Safety check 1</string></property><property name="font"><font><pointsize>11</pointsize><weight>75</weight><bold>true</bold></font></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="0" column="1" colspan="2"><widget class="QLabel" name="label_aState"><property name="text"><string>Not done</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="1" column="0"><widget class="QLabel" name="label_aRow1"><property name="text"><string>Empty images</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="1" column="1" colspan="2"><widget class="QListWidget" name="listWidget_aImages"><property name="maximumSize"><size><width>16777215</width><height>70</height></size></property><property name="toolTip"><string>Empty images saved for this recipe; select one to delete it.</string></property></widget></item><item row="2" column="0"><widget class="QLabel" name="label_aRow2"><property name="text"><string>Threshold</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="2" column="1"><widget class="QDoubleSpinBox" name="dspin_aThreshold"><property name="decimals"><number>2</number></property><property name="minimum"><double>0</double></property><property name="maximum"><double>1000000</double></property><property name="singleStep"><double>1</double></property><property name="keyboardTracking"><bool>false</bool></property><property name="minimumSize"><size><width>80</width><height>0</height></size></property></widget></item><item row="3" column="0" colspan="3"><layout class="QHBoxLayout" name="hl_aButtons"><property name="spacing"><number>6</number></property><item><widget class="QToolButton" name="toolButton_aSnapEmpty"><property name="text"><string>Snap empty</string></property><property name="toolTip"><string>With NO trolley loaded: go to machine home (X 0, Y 0, Z 0), snap with the recipe 2D light and keep it as an empty image.</string></property></widget></item><item><widget class="QToolButton" name="toolButton_aDelete"><property name="text"><string>Delete selected</string></property><property name="toolTip"><string>Remove the selected empty image (the file goes on Save).</string></property></widget></item><item><widget class="QToolButton" name="toolButton_aScore"><property name="text"><string>Score now</string></property><property name="toolTip"><string>Go to machine home, snap, and show how different the view is from each empty image.</string></property></widget></item><item><spacer name="hs_aButtons"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item></layout></item><item row="4" column="0" colspan="3"><widget class="QLabel" name="label_aResult"><property name="text"><string>No score yet.</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="5" column="0" colspan="3"><widget class="QLabel" name="label_aNote"><property name="text"><string>Every snap here goes to machine home (X 0, Y 0, Z 0) first, with the recipe 2D light; out of focus is fine. Snap empty with no trolley loaded. Score now gives the difference from each empty image (0 = identical, grey levels): set the threshold between the empty scores and the loaded ones.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item></layout></widget></item><item><widget class="QFrame" name="frame_b"><property name="frameShape"><enum>QFrame::StyledPanel</enum></property><property name="styleSheet"><string notr="true">QFrame{background-color:#272c36; border-radius:12px;}QLabel{color:#F0F0F0;}QCheckBox{color:#F0F0F0;}QCheckBox::indicator:checked{background-color:#5F8FCB; border:3px solid #9DB8E0;}QSpinBox, QDoubleSpinBox, QComboBox{background-color:rgb(27,29,35); color:#F0F0F0; border:1px solid rgb(27,29,35); border-radius:5px; padding-left:6px; min-height:22px;}QListWidget{backgr