gs"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="2" column="1"><widget class="QDoubleSpinBox" name="dspin_h3DLen"><property name="decimals"><number>2</number></property><property name="minimum"><double>0</double></property><property name="maximum"><double>500</double></property><property name="singleStep"><double>0.5</double></property><property name="keyboardTracking"><bool>false</bool></property><property name="minimumSize"><size><width>80</width><height>0</height></size></property><property name="suffix"><string> mm</string></property></widget></item><item row="3" column="0"><widget class="QLabel" name="label_hRow3"><property name="text"><string>3D scan direction</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="3" column="1"><widget class="QComboBox" name="comboBox_hScanDir"><item><property name="text"><string>+X</string></property></item><item><property name="text"><string>-X</string></property></item><item><property name="text"><string>+Y</string></property></item><item><property name="text"><string>-Y</string></property></item></widget></item><item row="4" column="0"><widget class="QLabel" name="label_hRowLaser"><property name="text"><string>3D laser XY</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="4" column="1" colspan="2"><widget class="QCheckBox" name="checkBox_hAddLaser"><property name="toolTip"><string>Ticked: every 3D scan runs where the camera looked at the point (the stage moves by the camera-to-laser XY offset). Unticked: the stage goes to the point as it is, and the laser scans one offset away. The offset's Z is never added: scans run at the 3D Centre Z + the Z offset.</string></property><property name="text"><string>Add the camera-to-laser XY offset</string></property><property name="checked"><bool>true</bool></property></widget></item><item row="5" column="0" colspan="3"><widget class="QLabel" name="label_hFound"><property name="text"><string></string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="6" column="0" colspan="3"><widget class="QLabel" name="label_hNote"><property name="text"><string>Offsets are in mm along the trolley axes (+X right, +Y towards the operator); Z offset + = down. Set needs the trolley found in this session (Check in D or Locate): jog the camera to the spot on any unit and press Set, then fine-tune the numbers. A new Ref keeps the point where it is and recalculates the offset.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item></layout></widget></item><item><widget class="QFrame" name="frame_i"><property name="frameShape"><enum>QFrame::StyledPanel</enum></property><property name="styleSheet"><string notr="true">QFrame{background-color:#272c36; border-radius:12px;}QLabel{color:#F0F0F0;}QCheckBox{color:#F0F0F0;}QCheckBox::indicator:checked{background-color:#5F8FCB; border:3px solid #9DB8E0;}QSpinBox, QDoubleSpinBox, QComboBox{background-color:rgb(27,29,35); color:#F0F0F0; border:1px solid rgb(27,29,35); border-radius:5px; padding-left:6px; min-height:22px;}QListWidget{background-color:rgb(27,29,35); color:#F0F0F0; border-radius:5px;}QToolButton{background-color:#4A5F8C; color:#F0F0F0; border-radius:6px; padding:4px 10px;}QToolButton:hover{background-color:#5F8FCB;}QToolButton:pressed{border:1px solid #FFE723;}QToolButton:checked{background-color:#5F8FCB; border:1px solid #FFE723;}QToolButton:disabled{color:#6e6e6e; background-color:#444444;}</string></property><layout class="QGridLayout" name="gl_i"><property name="horizontalSpacing"><number>10</number></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel" name="label_iTitle"><property name="text"><string>I   Tests</string></property><property name="font"><font><pointsize>11</pointsize><weight>75</weight><bold>true</bold></font></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="0" column="1" colspan="2"><widget class="QLabel" name="label_iState"><property name="text"><string>Not done</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="1" column="0" colspan="3"><layout class="QHBoxLayout" name="hl_iButtons"><property name="spacing"><number>6</number></property><item><widget class="QToolButton" name="toolButton_iLocate"><property name="text"><string>Locate</string></property><property name="toolTip"><string>Run START steps 1-5: Safety check 1 at home, fid0, 3D Z and the four corners; the layout then shows the trolley where it was found.</string></property></widget></item><item><spacer name="hs_iButtons"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item></layout></item><item row="2" column="0"><widget class="QLabel" name="label_iRowMove"><property name="text"><string>Move only</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="2" column="1" colspan="2"><layout class="QHBoxLayout" name="hl_iMove"><property name="spacing"><number>6</number></property><item><widget class="QComboBox" name="comboBox_iMoveWhat"><property name="toolTip"><string>Which points: the 2D and Barcode + OCR points, the 3D scans, or both (the 2D pass, then the 3D pass)</string></property><item><property name="text"><string>2D</string></property></item><item><property name="text"><string>3D</string></property></item><item><property name="text"><string>2D + 3D</string></property></item></widget></item><item><widget class="QToolButton" name="toolButton_iMove"><property name="text"><string>Start</string></property><property name="toolTip"><string>Move through every point of the selected slots' units (all units when none is selected) in run order, as production will - no snap, no scan.</string></property></widget></item><item><spacer name="hs_iMove"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item></layout></item><item row="3" column="0"><widget class="QLabel" name="label_iRowCapture"><property name="text"><string>Snap and scan</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="3" column="1" colspan="2"><layout class="QHBoxLayout" name="hl_iCapture"><property name="spacing"><number>6</number></property><item><widget class="QComboBox" name="comboBox_iCaptureWhat"><property name="toolTip"><string>Which points: the 2D and Barcode + OCR points, the 3D scans, or both (the 2D pass, then the 3D pass)</string></property><item><property name="text"><string>2D</string></property></item><item><property name="text"><string>3D</string></property></item><item><property name="text"><string>2D + 3D</string></property></item></widget></item><item><widget class="QToolButton" name="toolButton_iCapture"><property name="text"><string>Start</string></property><property name="toolTip"><string>Production's own capture at every point of the selected slots' units (all units when none is selected): a 2D snap saved as &lt;unit&gt;_2D, the barcode readers + OCR, the 3D scans - saved in a new production folder and inspected as in production. 3D scans run along X only.</string></property></widget></item><item><spacer name="hs_iCapture"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item></layout></item><item row="4" column="0"><widget class="QLabel" name="label_iRowGo"><property name="text"><string>Go to</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="4" column="1" colspan="2"><layout class="QHBoxLayout" name="hl_iGo"><property name="spacing"><number>6</number></property><item><widget class="QComboBox" name="comboBox_iGoPos"><property name="toolTip"><string>Where on the selected unit or slot (top = far side, bottom = operator side, as in the layout); the inspection points are a unit's</string></property><item><property name="text"><string>Centre</string></property></item><item><property name="text"><string>Top left</string></property></item><item><property name="text"><string>Top</string></property></item><item><property name="text"><string>Top right</string></property></item><item><property name="text"><string>Left</string></property></item><item><property name="text"><string>Right</string></property></item><item><property name="text"><string>Bottom left</string></property></item><item><property name="text"><string>Bottom</string></property></item><item><property name="text"><string>Bottom right</string></property></item><item><property name="text"><string>2D point</string></property></item><item><property name="text"><string>Barcode + OCR point</string></property></item><item><property name="text"><string>3D scan start</string></property></item></widget></item><item><widget class="QComboBox" name="comboBox_iGoWith"><property name="toolTip"><string>Which looks there: the 2D camera (at the 2D Z) or the 3D profiler (the laser, at the 3D Centre Z)</string></property><item><property name="text"><string>2D camera</string></property></item><item><property name="text"><string>3D profiler</string></property></item></widget></item><item><widget class="QToolButton" name="toolButton_iGo"><property name="text"><string>Go</string></property><property name="toolTip"><string>Move the camera or the profiler to that position of the unit selected in the layout (else the one selected slot).</string></property></widget></item><item><spacer name="hs_iGo"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item></layout></item><item row="5" column="0" colspan="3"><widget class="QLabel" name="label_iResult"><property name="text"><string>Locate has not run.</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="6" column="0" colspan="3"><widget class="QLabel" name="label_iNote"><property name="text"><string>Locate needs sections A to D set up; a step that passes counts as that section's Find or Check, and its last step checks that every camera, reader and laser position of the layout is inside the soft limits. Move only and Go to need the trolley found in this session (Check in D or Locate). Move only takes the selected slots' units (every unit when none is selected) in run order, without snapping or scanning. Go to takes the unit selected in the layout, else the one selected slot.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color:#A8B0BF;</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item></layout></widget></item><item><spacer name="vs_sections"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item></layout></widget></widget></item>
