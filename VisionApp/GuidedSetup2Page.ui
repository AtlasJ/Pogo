olTip"><string>Ticked: the laser goes to the spot the camera looked at when Set spot was pressed (the stage moves by the camera-to-laser XY offset). Unticked: the stage goes to fid0 + the spot offset as it is, and the laser reads wherever that puts it.</string></property><property name="text"><string>Add the camera-to-laser XY offset</string></property><property name="checked"><bool>true</bool></property></widget></item><item row="3" column="0"><widget class="QLabel" name="label_cRow3DZ"><property name="text"><string>3D Centre Z</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="3" column="1" colspan="2"><widget class="QLabel" name="label_c3DZ"><property name="toolTip"><string>The 3D Centre Z of the last Find that passed with these settings, and the profiler reading at the 2D Z it came from.</string></property><property name="text"><string>-</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="4" column="0"><widget class="QLabel" name="label_cRow3"><property name="text"><string>Target reading</string></property><property name="textInteractionFlags"><set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set></property></widget></item><item row="4" column="1"><widget class="QDoubleSpinBox" name="dspin_cTarget"><property name="decimals"><number>3</number></property><property name="minimum"><double>-7</double></property><property name="maximum"><double>7</double></property><property name="singleStep"><double>0.01</double></property><property name="keyboardTracking"><bool>false</bool></property><property name="minimumSize"><size><width>80</width><height>0</height></size></property><property name="suffix"><string> mm</string></property></widget></item><item row="5" column="0"><widget class="QLabel" name="la