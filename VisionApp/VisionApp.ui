                                   <string notr="true">buttonGroup_algoH2Section</string>
                                  </attribute>
                                 </widget>
                                </item>
                                <item>
                                 <layout class="QHBoxLayout" name="hl_algoH2Load">
                                  <item>
                                   <widget class="QToolButton" name="toolButton_algoH2LoadHeight">
                                    <property name="minimumSize">
                                     <size>
                                      <width>130</width>
                                      <height>26</height>
                                     </size>
                                    </property>
                                    <property name="toolTip">
                                     <string>Load a 16-bit height map tiff. This is the image everything is measured from.

raw_heightmap.tiff from a Profiler Scan Test is unprocessed - no resize, no rotate - so it is the cleanest input available. heightmap.tiff from a production run has already been resampled.</string>
                                    </property>
                                    <property name="text">
                                     <string>Load Heightmap...</string>
                                    </property>
                                   </widget>
                                  </item>
                                  <item>
                                   <widget class="QToolButton" name="toolButton_algoH2LoadIntensity">
                                    <property name="minimumSize">
                                     <size>
                                      <width>130</width>
                                      <height>26</height>
                                     </size>
                                    </property>
                                    <property name="toolTip">
                                     <string>Load the matching 8-bit luminance map. Optional - nothing measures from it yet - but it is carried alongside the height map so it is available later, and pin tops and pad edges are far easier to see in it when placing ROIs.

It must be the same width and height as the height map, or the pair is rejected.</string>
                                    </property>
                                    <property name="text">
                                     <string>Load Intensity...</string>
                                    </property>
                                   </widget>
                                  </item>
