	color: #F0F0F0;
}

QFrame{
	background-color: #272c36;
	border-radius:16px;
}

QPushButton{
	background-color: rgb(27, 29, 35);
	border: 1px solid #3c4454;
	border-radius: 5px;
	color: #F0F0F0;
	padding: 6px 12px;
}

QPushButton:hover{
	background-color: #3c4454;
}

QPushButton:pressed{
	background-color: #1b1d23;
}

QSpinBox{
	background-color: rgb(27, 29, 35);
	border: 1px solid rgb(27, 29, 35);
	border-radius: 5px;
	padding-left: 6px;
	color: #F0F0F0;
}

QTableWidget{
	background-color: rgb(27, 29, 35);
	border: 1px solid #3c4454;
	border-radius: 5px;
	color: #F0F0F0;
	gridline-color: #3c4454;
	selection-background-color: #568af2;
}

