                                    <property name="maximumSize">
                                     <size>
                                      <width>90</width>
                                      <height>16777215</height>
                                     </size>
                                    </property>
                                    <property name="toolTip">
                                     <string>Microns per pixel along the scan. Read from the profiler and locked when one is connected; editable offline.

On a PROCESSED map this equals the X pitch - both axes are resampled to the same output pitch, so 5.0. It only differs on a RAW tiff straight from the scan test, where it is yPitchUm x divider.</string>
                                    </property>
                                    <property name="decimals">
                                     <number>3</number>
                                    </property>
