                            <string>Manual Align Laser</string>
                           </property>
                          </widget>
                         </item>
                         <item>
                          <widget class="QToolButton" name="toolButton_alignLaser">
                           <property name="sizePolicy">
                            <sizepolicy hsizetype="Minimum" vsizetype="Fixed">
                             <horstretch>0</horstretch>
                             <verstretch>0</verstretch>
                            </sizepolicy>
                           </property>
