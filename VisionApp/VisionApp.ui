                                      <height>16777215</height>
                                     </size>
                                    </property>
                                    <property name="toolTip">
                                     <string>Microns per pixel across the laser line. Read from the profiler and locked when one is connected; editable offline so a saved map can be replayed on a PC with no sensor.

With 3D Native Resolution on - which this project always uses - it is the sensor's own pitch, 5.0 um, and it does NOT change with the divider.</string>
                                    </property>
                                    <property name="decimals">
                                     <number>3</number>
                                    </property>
                                    <property name="minimum">
                                     <double>0.010000000000000</double>
                                    </property>
                                    <property name="maximum">
                                     <double>10000.000000000000000</double>
                                    </property>
                                    <property name="value">
                                     <double>5.000000000000000</double>
                                    </property>
                                   </widget>
                                  </item>
