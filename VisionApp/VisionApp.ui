                                      <height>26</height>
                                     </size>
                                    </property>
                                    <property name="toolTip">
                                     <string>Use the height map from the most recent 3D scan instead of a file. Both maps come through together, already aligned.</string>
                                    </property>
                                    <property name="text">
                                     <string>Use Last Scan</string>
                                    </property>
                                   </widget>
