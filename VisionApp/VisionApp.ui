                         <string notr="true">QLabel{
                	 font-size: 9pt;
                }

                QFrame{
                	background-color: #272c36;
                	border-radius:16px;
                }

                QGroupBox{
                 border: 1px solid #3c4454;
                 border-radius: 8px;
                 margin-top: 14px;
                 color: #F0F0F0;
                 font-weight: bold;
                }

                QGroupBox::title{
                 subcontrol-origin: margin;
                 left: 10px;
                }

                QLineEdit{
                background-color: rgb(27, 29, 35);
                border: 1px solid rgb(27, 29, 35);
                border-radius: 5px;
                padding-left: 10px;
                color: #F0F0F0;
                }

                QLineEdit[readOnly=true] {
                    background: rgb(57, 59, 65);
                    color: #F0F0F0;
                	border: 1px solid rgb(57, 59, 65);
                }

                QCheckBox{
                border-radius: 5px;
                padding: 2px;
                color: #F0F0F0;
                }

                QLabel{
                border-radius: 5px;
                padding: 2px;
                color: #F0F0F0;
                }

                QToolButton {
                  background-color:  #545963;
                  color: #F0F0F0;
                  border-radius: 8px;
                  margin: 0px;
                  padding: 4px;
                }

                QToolButton:pressed {
                   margin: 1px;
                   border: 1px solid #FFE723;
                }

                QToolButton:disabled {
                	color: #6e6e6e;
                	background-color: #444444;
                	border: 2px solid #444444;
                }

                QToolButton:hover {
                 background-color: #929aaa;
                }</string>
