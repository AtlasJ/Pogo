                                      <height>16777215</height>
                                     </size>
                                    </property>
                                    <property name="toolTip">
                                     <string>Grey levels per micron. For the LJ-X8060 this is 1.25, because the head reports 0.8 um per grey level. Note the units are INVERTED between the two - entering 0.8 here is wrong by a factor of 1.5625.</string>
                                    </property>
                                    <property name="decimals">
                                     <number>3</number>
                                    </property>
                                    <property name="minimum">
                                     <double>0.010000000000000</double>
                                    </property>
                                    <property name="maximum">
                                     <double>1000.000000000000000</double>
